# Server configuration
HOST=0.0.0.0
PORT=8000

# Whisper model size (tiny, base, small, medium, large-v2, large-v3)
WHISPER_MODEL=base

# Compute device (cpu, cuda)
WHISPER_DEVICE=cpu

# Compute type (int8, float16, float32)
WHISPER_COMPUTE_TYPE=int8

# Supabase configuration
# Get these from your Supabase project settings (https://app.supabase.com)
# Settings -> API
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=video-storage

# Anthropic (Claude) — used to select clips from the transcript
ANTHROPIC_API_KEY=your-anthropic-api-key

# Shared secret required on every request (X-Internal-Api-Key header).
# Must match FASTAPI_INTERNAL_API_KEY on the frontend. Generate with e.g. `openssl rand -hex 32`.
INTERNAL_API_KEY=your-long-random-shared-secret

# Job queue tuning (all optional, defaults shown)
MAX_VIDEO_DURATION_SECONDS=1800
MAX_CONCURRENT_JOBS=2
WORKER_POLL_INTERVAL=3
JOB_STALE_TIMEOUT_MINUTES=15
